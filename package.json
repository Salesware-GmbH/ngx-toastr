{
  "name": "ngx-toastr-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ngx-toastr",
    "publish": "npm publish --access=public dist/ngx-toastr/",
