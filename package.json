    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@ctrl/ngx-github-buttons": "^9.0.0",
    "bootstrap": "^5.3.8",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "lodash-es": "^4.17.22",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
